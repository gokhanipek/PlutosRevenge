# Pluto's Revenge — the game's own Supabase project (not the website's).
# Copy to .env and fill in. Without these the game still runs; a run then
# persists locally only and is not mirrored anywhere.
#
# Both values are safe to ship in a client bundle: the anon key is public by
# design and row-level security is what protects the data. Never put the
# service role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key
